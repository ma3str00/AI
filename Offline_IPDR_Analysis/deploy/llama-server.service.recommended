# Drop-in replacement for /etc/systemd/system/llama-server.service.
# Keeps the current model, context, batch, flash attention, and port 11434.
# Changes: generation threads 16, prompt threads 28, lock weights in RAM, listen on localhost only.

[Unit]
Description=Llama.cpp API Server Engine
After=network.target

[Service]
Type=simple
User=maestro
Group=maestro
WorkingDirectory=/home/maestro/ollama/llama.cpp
CPUAffinity=0-27
LimitNOFILE=65536
LimitMEMLOCK=infinity
ExecStart=/home/maestro/ollama/llama.cpp/build/bin/llama-server \
  -m /home/maestro/ollama/llama.cpp/qwen2.5-coder-3b-instruct-q4_k_m.gguf \
  -c 8192 \
  -np 1 \
  -t 16 \
  -tb 28 \
  -b 2048 \
  -ub 512 \
  -fa auto \
  --mlock \
  --port 11434 \
  --host 127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
