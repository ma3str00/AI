# The 3B model was generating at about 3 tokens/s once the slot context reached ~2700 tokens,
# and -tb 28 pushed the machine load to about 26. This unit keeps generation on 8 threads
# and prompt processing on 16, with a 4096 context so the slot cannot grow that deep.

[Unit]
Description=Llama.cpp API Server Engine
After=network.target

[Service]
Type=simple
User=maestro
Group=maestro
WorkingDirectory=/home/maestro/ollama/llama.cpp
CPUAffinity=0-15
LimitNOFILE=65536
LimitMEMLOCK=infinity
ExecStart=/home/maestro/ollama/llama.cpp/build/bin/llama-server \
  -m /home/maestro/ollama/llama.cpp/qwen2.5-coder-3b-instruct-q4_k_m.gguf \
  -c 4096 \
  -np 1 \
  -t 8 \
  -tb 16 \
  -b 2048 \
  -ub 512 \
  -fa auto \
  --mlock \
  --port 11434 \
  --host 127.0.0.1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
